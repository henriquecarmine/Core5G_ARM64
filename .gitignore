# segredos — ficam só no Google Drive
.env
server/.env
ssl/

# artefatos binários grandes — ficam no Google Drive / GHCR
artifacts/oai-images/*.tar
artifacts/oai-images/*.tar.gz
artifacts/oai-images/*.zip

.DS_Store
client/.venv/
client/__pycache__/
.claude/

# bytecache do Python (churn a cada execução/deploy — nunca versionar)
__pycache__/
*.pyc

# Plugins SM do FlexRIC: artefatos de build, arquitetura-específicos.
# NÃO versionar (o repo carregava x86-64 e o sync-oai quebrava o RIC arm64).
# up_flexric.sh popula flexric-lib/ do build tree por arquitetura do host.
server/oai-cn-gnb-e2/flexric-lib/*.so

# Teste visual do painel (deps locais + artefatos)
server/panel/test/node_modules/
server/panel/test/screenshots/

# Wheels vendorizados (aarch64, ~57MB) — binários grandes ficam fora do git
# (mesma política das imagens OAI). Chegam ao servidor pelo rsync do deploy;
# para recriar: server/panel/vendor/README.md
server/panel/vendor/wheels/

# Dados de runtime do painel (Resultados salvos, roster, dúvidas do lab)
# — gerados em produção pelo server.py, nunca versionar
server/panel_results/

# App desktop local de administração da instância AWS (liga/desliga) —
# ferramenta pessoal do operador, fica fora do repo público por decisão
admin-local/
