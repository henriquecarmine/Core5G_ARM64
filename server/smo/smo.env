# SMO O-RAN SC (OAM) no Graviton — variáveis que o up_smo.sh exporta antes do
# docker compose. Variável de ambiente vence o .env do upstream, então é aqui
# que as imagens amd64 viram as do build_arm64.sh. Sem segredos neste arquivo.

# --- Traefik mais novo que o do upstream ---
# O v3.3.6 do upstream fixa a API 1.24 do Docker, que o Docker 29 deste servidor
# recusa ("client version 1.24 is too old"); sem ler os rótulos dos contêineres
# o gateway fica sem rotas e tudo responde 404. DOCKER_API_VERSION não adianta
# (testado). O v3.6 negocia a versão da API.
TRAEFIK_IMAGE=traefik:v3.6.25

# --- imagens construídas por build_arm64.sh ---
SDNC_IMAGE=core5g/oam-sdnr:13.0.1-arm64
SDNC_WEB_IMAGE=core5g/oam-sdnr-web:13.0.1-arm64
VES_COLLECTOR_IMAGE=core5g/ves-collector:1.12.5-arm64
O_RAN_SC_TOPOLOGY_IMAGE=core5g/smo-nts-ng-topology-server:1.5.2-arm64
LOCAL_DOCKER_REPO=core5g/
PYNTS_VERSION=1212417-arm64

# --- domínio ---
# Subdomínio do host do painel (o DuckDNS resolve qualquer nível abaixo dele).
# Sendo assim, o infra/server-bootstrap.sh põe no Caddy o console ODLUX e o
# login do Keycloak, com certificado válido; o up_smo.sh troca o domínio de
# exemplo do upstream (smo.o-ran-sc.org) na cópia de trabalho; e o
# smo_acesso_web.sh fecha o Keycloak antes de ele ir para a internet.
HTTP_DOMAIN=smo.core5g-arm64.duckdns.org

# --- rede ---
# O host já usa 80/443 (Caddy do painel). Upstream, os simuladores e o
# controlador chegam ao gateway (Traefik) pelo IP do host; aqui chegam pelo IP
# fixo do gateway dentro da rede dcn, e o host só publica o Traefik em
# 127.0.0.1: quem fala com a internet é o Caddy. SMO_GATEWAY_IP ocupa o lugar do HOST_IP.
SMO_DCN_IPV4_SUBNET=10.250.50.0/24
SMO_GATEWAY_IP=10.250.50.10
# Quem está só na dmz (kafka-ui) acha o Keycloak pelo IP do gateway nessa rede.
SMO_DMZ_IPV4_SUBNET=10.250.51.0/24
SMO_GATEWAY_DMZ_IP=10.250.51.10
SMO_HTTPS_PORT=8443
SMO_HOST_IFACE=ens5
